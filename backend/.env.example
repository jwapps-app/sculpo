# Copy to .env for local development.
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5436/app
SECRET_KEY=dev-secret-change-me
APP_URL=http://localhost:5199
ALLOWED_EMAILS=you@example.com
# SMTP is optional in dev (debug surfaces the magic link in the response).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
