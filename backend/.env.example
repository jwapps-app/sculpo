# Copy to .env for local development.
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5436/app
SECRET_KEY=dev-secret-change-me
# Admin usernames (comma-separated). Admins register themselves and invite
# everyone else from the UI.
ADMIN_USERS=john
# Required to register an ADMIN_USERS name. Without it, on a public
# instance whoever registers that username first becomes admin.
ADMIN_SIGNUP_SECRET=
